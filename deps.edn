;; No dependencies. ISO 8583 is bitmaps, BCD-packed and ASCII digits, and a
;; field table; a leaf that dragged a network/acquirer-switch stack behind
;; it would defeat the point, which is that the wire codec can be used
;; anywhere .cljc runs -- including inside a WASM guest -- without a JVM.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
